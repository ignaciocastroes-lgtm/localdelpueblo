# Copia este archivo como .env.local para desarrollar en tu computador,
# y carga las mismas variables en Vercel: Project → Settings →
# Environment Variables.
#
# IMPORTANTE: ninguna de estas variables lleva el prefijo NEXT_PUBLIC_,
# lo que significa que quedan solo en el servidor y nunca se envían al
# navegador/tablet. Así deben quedar SIEMPRE — son credenciales.

# --- Mercado Pago ---
# Access Token de PRODUCCIÓN de tu cuenta de Mercado Pago (no el de prueba).
# Se obtiene en: https://www.mercadopago.cl/developers/panel/app
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Make (libro de ventas / contabilidad) ---
# URL del webhook "Custom Webhook" que creas en tu escenario de Make.
# Ese escenario es el que escribe en tu Google Sheet / sistema contable real.
MAKE_WEBHOOK_URL=https://hook.us1.make.com/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
